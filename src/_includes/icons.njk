{%- elif name == "linkedin" -%}<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M20.4 20.4h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.4V9h3.4v1.6c.5-.9 1.6-1.8 3.4-1.8 3.6 0 4.3 2.4 4.3 5.5v6.1zM5.3 7.4a2.1 2.1 0 1 1 0-4.2 2.1 2.1 0 0 1 0 4.2zM7.1 20.4H3.6V9h3.5v11.4zM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 .9.8 1.7 1.8 1.7h20.4c1 0 1.8-.8 1.8-1.7V1.7C24 .8 23.2 0 22.2 0z"/></svg>
{%- elif name == "twitter" -%}<svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M18.2 2.3h3.4l-7.4 8.4 8.7 11.5h-6.8l-5.3-7-6.1 7H1.3l7.9-9L.9 2.3h7l4.8 6.3 5.5-6.3zm-1.2 17.9h1.9L7.1 4.2H5.1l11.9 16z"/></svg>
{%- elif name == "email" -%}<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="3"/><path d="m2 7 10 6 10-6"/></svg>
{%- elif name == "ext" -%}<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 4h6v6M20 4 10 14M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/></svg>
{%- elif name == "pin" -%}<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>
{%- elif name == "arrow" -%}<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
{%- elif name == "back" -%}<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
{%- endif -%}
{%- endmacro -%}

{%- macro socials(c, extraClass="") -%}
<div class="socials {{ extraClass }}">
  {%- if c.github %}<a href="{{ c.github }}" target="_blank" rel="noopener" aria-label="GitHub">{{ icon("github") | safe }}</a>{% endif -%}
  {%- if c.linkedin %}<a href="{{ c.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn">{{ icon("linkedin") | safe }}</a>{% endif -%}
  {%- if c.twitter %}<a href="{{ c.twitter }}" target="_blank" rel="noopener" aria-label="X / Twitter">{{ icon("twitter") | safe }}</a>{% endif -%}
  {%- if c.email %}<a href="mailto:{{ c.email }}" aria-label="Email">{{ icon("email") | safe }}</a>{% endif -%}
</div>
{%- endmacro -%}

{%- macro projectLinks(p) -%}
<div class="project-links">
  {%- if p.live %}<a class="live" href="{{ p.live }}" target="_blank" rel="noopener">Live demo {{ icon("ext") | safe }}</a>{% endif -%}
  {%- if p.code %}<a href="{{ p.code }}" target="_blank" rel="noopener">{{ icon("github") | safe }} Code</a>{% endif -%}
</div>
{%- endmacro -%}
